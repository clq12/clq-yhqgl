# 数据库配置（云端部署时需要配置）
# 这个环境变量由 coze-coding-dev-sdk 自动管理，无需手动配置
# PGDATABASE_URL=postgresql://user:password@host:5432/database

# GLM API配置（可选，用于GLM-4模型）
# 如果需要使用GLM-4.7-Flash进行图片识别，需要配置此变量
# GLM_API_KEY=your_glm_api_key_here

# Next.js 配置
NEXT_PUBLIC_APP_NAME=优惠券管理
NEXT_PUBLIC_APP_DESCRIPTION=轻松记录和管理您的优惠信息

# Vercel部署说明：
# 1. 免费版：API请求超时限制为10秒，适合小图片（<1MB）识别
# 2. Pro版：API请求超时限制为60秒，适合大图片识别
# 3. 图片识别功能使用豆包AI（doubao-seed-1-8-251228），无需额外配置
# 4. 如果需要使用GLM-4模型，请在Vercel环境变量中配置GLM_API_KEY
# 5. 推荐图片大小：<2MB，格式：JPG、PNG、WEBP
