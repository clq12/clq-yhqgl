{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/clq12/clq-yhqgl/shared/schemas/settings.json",
  "title": "AppSettings",
  "description": "应用设置，包含同步、AI、提醒配置。敏感字段仅在本地加密存储。",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 2
    },
    "webdav": {
      "type": "object",
      "required": ["url", "username", "password"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "rootPath": {
          "type": "string",
          "default": "/yhqgl/v2",
          "description": "WebDAV 上的应用根目录"
        }
      }
    },
    "sync": {
      "type": "object",
      "properties": {
        "autoSync": { "type": "boolean", "default": true },
        "syncIntervalMinutes": { "type": "integer", "default": 15, "minimum": 1 },
        "syncOnWifiOnly": { "type": "boolean", "default": false }
      }
    },
    "reminder": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "remindDays": {
          "type": "array",
          "items": { "type": "integer", "enum": [1, 3, 7] },
          "default": [7, 3, 1]
        },
        "quietStart": { "type": ["string", "null"], "description": "免打扰开始时间，HH:mm" },
        "quietEnd": { "type": ["string", "null"], "description": "免打扰结束时间，HH:mm" }
      }
    },
    "ai": {
      "type": "object",
      "properties": {
        "provider": { "type": "string", "default": "agnes" },
        "apiKey": { "type": ["string", "null"] },
        "baseUrl": { "type": ["string", "null"], "description": "自定义 API 基础地址" },
        "model": { "type": ["string", "null"], "description": "模型名称，留空使用 Provider 默认" }
      }
    }
  },
  "additionalProperties": false
}
